{
  "productName": "Stitch Studio",
  "version": "0.1.0",
  "identifier": "com.stitchstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stitch Studio",
        "dragDropEnabled": false,
        "width": 1600,
        "maximized": true,
        "height": 900,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../NOTICE": "licenses/NOTICE",
      "../../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md"
    },
    "icon": [
      "../../packaging/macos/AppIcon.png",
      "../../packaging/macos/AppIcon.icns",
      "../../packaging/windows/AppIcon.ico"
    ]
  }
}
